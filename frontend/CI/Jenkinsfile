pipeline {
    
    agent {
        label "task-manager"
    }

    triggers {
        pollSCM("* * * * *")
    }

    stages {
        stage ("Git Checkout") {
            steps {
                git url: "https://github.com/opsbyNikhil/task-manager.git",
                    branch: "dev"
            }
        }

        stage ("Install Dependencies") {
            dir ("frontend") {
                steps {
                    sh """
                        npm install
                    """
                }
            }
        }

        stage ("Build Frontend") {
            dir ("frontend") {
                sh """
                    npm run build
                """
            }
        }
    }
}