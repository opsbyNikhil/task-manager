pipeline {
    environment {
        AWS_ACCESS_KEY_ID = credentials("AWS_ACCESS_KEY_ID")
        AWS_SECRET_ACCESS_KEY = credentials("AWS_SECRET_ACCESS_KEY")
        AWS_ACCOUNT_ID = credentials("AWS_ACCOUNT_ID")
        AWS_REGION = credentials("AWS_REGION")
        AWS_REPOSITORY_FRONTEND = credentials("AWS_REPOSITORY_FRONTEND")
        task_manager_frontend = "${BUILD_NUMBER}"
    }

    
    agent {
        label "task-manager"
    }

    // triggers {
    //     pollSCM("* * * * *")
    // }

    stages {
        stage ("Git Checkout") {
            steps {
                git url: "https://github.com/opsbyNikhil/task-manager.git",
                    branch: "dev"
            }
        }

        stage ("Install Dependencies") {
            steps {
                dir ("frontend") {
                    sh """
                        npm install
                    """
                }
            }
        }

        stage ("Build Frontend") {
            steps {
                dir ("frontend") {
                    sh """
                        npm run build
                    """
                }
            }
        }

        stage ("Deploy Frontend to S3") {
            steps {
                dir ("frontend") {
                    withCredentials([
                        string(
                            credentialsId: "AWS_ACCESS_KEY_ID",
                            variable: "AWS_ACCESS_KEY_ID"
                        ),
                        string(
                            credentialsId: "AWS_SECRET_ACCESS_KEY",
                            variable: "AWS_SECRET_ACCESS_KEY"
                        ),
                        string(
                            credentialsId: "AWS_REGION",
                            variable: "AWS_REGION"
                        ),
                        string(
                            credentialsId: "AWS_S3_BUCKET",
                            variable: "AWS_S3_BUCKET"
                        ),
                    ]) {
                        sh """
                            echo "uploading frontend build-${BUILD_NUMBER} to s3"
                            aws s3 sync dist/ \
                                s3://\$AWS_S3_BUCKET/build-${BUILD_NUMBER}/ \
                                --delete \
                                --region "\$AWS_REGION"

                            echo "Frontend deployment completed"
                        """
                    }
                }
            }
        }

        stage ("Sonarqube-Scan") {
            steps {
                dir("frontend") {
                    withCredentials([
                        string(
                            credentialsId: "SONAR_ID",
                            variable: "SONAR_TOKEN"
                    )]){
                        script {
                            def scannerhome = tool "SONAR_ID"
                            withSonarQubeEnv("SONAR_ID") {
                                sh """
                                    ${scannerhome}/bin/sonar-scanner \
                                        -Dsonar.projectKey=opsbyNikhil_task-manager \
                                        -Dsonar.organization=opsbynikhil \
                                        -Dsonar.host.url=https://sonarcloud.io \
                                        -Dsonar.login=$SONAR_TOKEN
                                """
                        }
                    }     
                    }
                }
            }
        }

        // stage ("Aikido Security Scan") {
        //     steps {
        //         dir("frontend") {
        //             withCredentials([
        //                 string(
        //                     credentialsId: "AIKIDO_TOKEN",
        //                     variable: "AIKIDO_TOKEN"
        //                 )
        //             ]) {
        //                 sh '''
        //                     BASE_COMMIT=$(git rev-parse HEAD~1)
        //                     HEAD_COMMIT=$(git rev-parse HEAD)

        //                     echo "Base commit: $BASE_COMMIT"
        //                     echo "Head commit: $HEAD_COMMIT"

        //                     aikido-api-client scan \
        //                         --apikey "$AIKIDO_TOKEN" \
        //                         task-manager \
        //                         "$BASE_COMMIT" \
        //                         "$HEAD_COMMIT" \
        //                         dev \
        //                         --minimum-severity-level HIGH
        //                 '''
        //             }
        //         }
        //     }
        // }

        stage("Set Docker Version") {
            when {
                expression {false}
            }
            steps {
                dir("frontend") {
                    script {

                        def currentVersion = sh(
                            script: 'cat VERSION',
                            returnStdout: true
                        ).trim()

                        def version = currentVersion.replace("v", "").split("\\.")

                        def major = version[0].toInteger()
                        def minor = version[1].toInteger()
                        def patch = version[2].toInteger()

                        patch++

                        env.DOCKER_VERSION = "v${major}.${minor}.${patch}"

                        sh """
                            echo "${env.DOCKER_VERSION}" > VERSION
                        """

                        echo "Previous Version: ${currentVersion}"
                        echo "New Docker Version: ${env.DOCKER_VERSION}"
                    }
                }
            }
        }

        stage ("Docker Build") {
            when {
                expression {false}
            }
            steps {
                dir("frontend") {
                    sh '''
                        echo "Building frontend Docker image: $DOCKER_VERSION"

                        docker compose build task-manager-frontend

                        echo "Frontend Docker image built successfully"
                        echo "Image: task-manager-frontend:$DOCKER_VERSION"
                    '''
                }
            }
        }

        stage("Push Docker Image to ECR") {
            when {
                expression {false}
            }
            steps {
                dir("frontend") {
                    withCredentials([
                        string(
                            credentialsId: "AWS_ACCESS_KEY_ID",
                            variable: "AWS_ACCESS_KEY_ID"
                        ),
                        string(
                            credentialsId: "AWS_SECRET_ACCESS_KEY",
                            variable: "AWS_SECRET_ACCESS_KEY"
                        ),
                        string(
                            credentialsId: "AWS_ACCOUNT_ID",
                            variable: "AWS_ACCOUNT_ID"
                        ),
                        string(
                            credentialsId: "AWS_REGION",
                            variable: "AWS_REGION"
                        ),
                        string(
                            credentialsId: "AWS_REPOSITORY_FRONTEND",
                            variable: "AWS_REPOSITORY_FRONTEND"
                        )
                    ]) {
                        sh '''
                            echo "Logging into Amazon ECR"

                            ECR_REGISTRY="$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com"

                            aws ecr get-login-password --region "$AWS_REGION" | \
                            docker login --username AWS --password-stdin "$ECR_REGISTRY"

                            echo "Tagging Frontend Docker Image"

                            docker tag \
                                "task-manager-frontend:$DOCKER_VERSION" \
                                "$ECR_REGISTRY/$AWS_REPOSITORY_FRONTEND:$DOCKER_VERSION"

                            echo "Pushing Frontend Docker Image"

                            docker push \
                                "$ECR_REGISTRY/$AWS_REPOSITORY_FRONTEND:$DOCKER_VERSION"

                            echo "Frontend Docker Image Successfully pushed to ECR"
                        '''
                    }
                }
            }
        }

        stage("Trivy Report") {
            steps {
                sh '''
                    wget -q https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/junit.tpl \
                        -O junit.tpl

                    echo "===== TRIVY VULNERABILITY SCAN ====="

                    trivy image \
                        --scanners vuln \
                        --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                        task-manager-frontend:$DOCKER_VERSION

                    echo "===== GENERATING JUNIT REPORT ====="

                    trivy image \
                        --scanners vuln \
                        --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL \
                        --format template \
                        --template "@junit.tpl" \
                        -o trivy-report.xml \
                        task-manager-frontend:$DOCKER_VERSION
                '''
            }
        }

        
    }

    post {
        always {
            archiveArtifacts artifacts: 'trivy-report.xml', fingerprint: true
            junit allowEmptyResults: true, testResults: 'trivy-report.xml'
        }
    }
}