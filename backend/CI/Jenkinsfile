pipeline {
    
    agent {
        label "task-manager"
    }
    
    triggers {
        pollSCM ("* * * * *")
    }

    stages {
        stage ("git checkout") {
            steps {
                git url: "https://github.com/opsbyNikhil/task-manager.git",
                    branch: "dev"
            }
        }

        stage ("Install Dependencies") {
            steps {
                dir ("backend") {
                    sh """
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -r requirements.txt
                    """
                }
            }
        }

        stage ("Run Tests") {
            steps {
                dir ("backend") {
                    withCredentials([
                        string(
                            credentialsId: 'SECRET_KEY',
                            variable: 'SECRET_KEY'
                        ),
                        string(
                            credentialsId: 'RESEND_API_KEY',
                            variable: 'RESEND_API_KEY'
                        ),
                    ]) 
                    {
                        sh """
                            if [ -z "$SECRET_KEY" ]; then
                                echo "SECRET_KEY is NOT available"
                                exit 1
                            else
                                echo "SECRET_KEY is available"
                            fi

                            if [ -z "$RESEND_API_KEY" ]; then
                                echo "RESEND_API_KEY is NOT available"
                                exit 1
                            else
                                echo "RESEND_API_KEY is available"
                            fi

                            . venv/bin/activate
                            python manage.py test
                        """
                    }
                }
            }
        }

    }
}